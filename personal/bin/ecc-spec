#!/usr/bin/env node
'use strict';

/**
 * Build the --spec for an Orca worker with ECC skills injected.
 *
 *   ecc-spec --skills tdd-workflow,python-patterns --task "Añade X" [--max-chars 9000] [--full]
 *   ecc-spec --auto --task "Hay un bug al guardar el carrito"   (picks skills from config/skill-triggers.json)
 *   ecc-spec --auto --skills extra-skill --task "..."           (auto matches are added to --skills, deduped)
 *
 * Output (stdout): preamble, the `ECC_REQUIRED_SKILLS:` tag the gates look for,
 * each SKILL.md body (capped), the task, and the closing contract.
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { loadTriggers, matchSkills } = require('../../scripts/lib/skill-router');
const { buildPlan, toWaves } = require('../../scripts/lib/personal-presets');

const SKILLS_DIR = process.env.ECC_SKILLS_DIR || path.join(os.homedir(), '.ecc-shared', 'repo', 'skills');
const TRIGGERS_PATH = process.env.ECC_TRIGGERS_FILE || path.join(__dirname, '..', '..', 'config', 'skill-triggers.json');
const DEFAULT_MAX_CHARS = 9000;
const AUTO_MAX_SKILLS = 3;

function parseArgs(argv) {
  const args = { skills: [], task: '', maxChars: DEFAULT_MAX_CHARS, auto: false, preset: '', stage: '', plan: false, lang: '', context: '' };
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i];
    if (flag === '--skills') args.skills = String(argv[++i] || '').split(',').map(s => s.trim()).filter(Boolean);
    else if (flag === '--task') args.task = String(argv[++i] || '');
    else if (flag === '--preset') args.preset = String(argv[++i] || '');
    else if (flag === '--stage') args.stage = String(argv[++i] || '');
    else if (flag === '--lang') args.lang = String(argv[++i] || '');
    else if (flag === '--context') args.context = String(argv[++i] || '');
    else if (flag === '--plan') args.plan = true;
    else if (flag === '--max-chars') args.maxChars = Number(argv[++i]) || DEFAULT_MAX_CHARS;
    else if (flag === '--full') args.maxChars = Infinity;
    else if (flag === '--auto') args.auto = true;
    else throw new Error(`Argumento desconocido: ${flag}`);
  }
  return args;
}

function stripFrontmatter(text) {
  return text.replace(/^---\n[\s\S]*?\n---\n/, '');
}

const RESOURCE_DIRS = ['references', 'scripts', 'data', 'templates', 'assets', 'examples'];

// Skills written for the Claude plugin run their helper scripts through
// `${CLAUDE_PLUGIN_ROOT}/skills/<name>/...`. A worker outside the plugin has
// no such variable, so the injected text points at the real skills dir.
function resolvePluginRoot(text, dir) {
  const shown = dir === SKILLS_DIR ? '~/.ecc-shared/repo/skills' : dir;
  return text.split('${CLAUDE_PLUGIN_ROOT}/skills/').join(`${shown}/`);
}

function describeSkillDir(name, dir) {
  const root = path.join(dir, name);
  const parts = RESOURCE_DIRS.filter(sub => fs.existsSync(path.join(root, sub))).map(sub => {
    const count = fs.readdirSync(path.join(root, sub), { recursive: true }).length;
    return `${sub}/ (${count})`;
  });
  const shown = dir === SKILLS_DIR ? `~/.ecc-shared/repo/skills/${name}` : root;
  return parts.length ? `Directorio: ${shown} — recursos: ${parts.join(', ')}` : `Directorio: ${shown}`;
}

function loadSkill(name, maxChars, dir = SKILLS_DIR) {
  if (!/^[A-Za-z0-9._-]+$/.test(name)) throw new Error(`Nombre de skill inválido: ${name}`);
  const file = path.join(dir, name, 'SKILL.md');
  if (!fs.existsSync(file)) throw new Error(`Skill no encontrada: ${name} (${file})`);
  const body = resolvePluginRoot(stripFrontmatter(fs.readFileSync(file, 'utf8')).trim(), dir);
  if (body.length <= maxChars) return body;
  return `${body.slice(0, maxChars).trimEnd()}\n\n[... recortada; texto completo en ${file}]`;
}

// Picks skills from config/skill-triggers.json by matching --task text, then
// merges with any explicit --skills (deduped, explicit first).
function resolveAutoSkills(args, triggersPath = TRIGGERS_PATH) {
  if (!args.auto) return args.skills;
  if (!args.task) throw new Error('--auto necesita --task para elegir skills');
  const triggers = loadTriggers(triggersPath);
  // Commands (kind: "command") have no SKILL.md to inject, so they are skipped here.
  const matches = matchSkills(args.task, triggers, { max: AUTO_MAX_SKILLS })
    .filter(m => m.kind !== 'command')
    .map(m => m.skill);
  return [...new Set([...args.skills, ...matches])];
}

const PRESETS_PATH = process.env.ECC_PRESETS_FILE || path.join(__dirname, '..', 'orchestration-presets.json');

function loadPresets(presetsPath = PRESETS_PATH) {
  return JSON.parse(fs.readFileSync(presetsPath, 'utf8'));
}

// Turns `--preset P --stage S` into explicit skills plus stage notes, so the
// rest of buildSpec stays the same.
function applyStage(args, presetsPath = PRESETS_PATH) {
  if (!args.preset || !args.stage) return args;
  const data = loadPresets(presetsPath);
  const plan = buildPlan(data, args.preset, { lang: args.lang });
  const stage = plan.stages.find(candidate => candidate.id === args.stage);
  if (!stage) throw new Error(`Etapa desconocida: ${args.stage} (disponibles: ${plan.stages.map(s => s.id).join(', ')})`);
  const notes = [];
  if (stage.readOnly) notes.push('Etapa de solo lectura: NO edites archivos; reporta hallazgos y propuestas.');
  if (stage.exclusive) notes.push('Etapa exclusiva: se ejecuta sola porque es pesada para la máquina.');
  return { ...args, skills: [...new Set([...args.skills, ...stage.skills])], notes };
}

// Stage commands the Orca coordinator can run, in launch order (waves).
function planWithCommands(args, presetsPath = PRESETS_PATH) {
  const plan = buildPlan(loadPresets(presetsPath), args.preset, { lang: args.lang });
  const langFlag = args.lang ? ` --lang ${args.lang}` : '';
  return {
    ...plan,
    waves: toWaves(plan),
    stages: plan.stages.map(stage => ({
      ...stage,
      command:
        `orca-ide orchestration worker-start --run <RUN_ID> --agent ${stage.agent} --worktree ${stage.worktree} --json ` +
        `--spec "$(~/.ecc-shared/bin/ecc-spec --preset ${args.preset} --stage ${stage.id}${langFlag} --task '<TAREA>' [--context '<resumen de etapas previas>'])"`
    }))
  };
}

function buildSpec(rawArgs, dir = SKILLS_DIR, triggersPath = TRIGGERS_PATH, presetsPath = PRESETS_PATH) {
  const args = applyStage(rawArgs, presetsPath);
  const skills = resolveAutoSkills(args, triggersPath);
  if (skills.length === 0) throw new Error('Falta --skills (o --auto, si el texto de --task no sugiere ninguna)');
  if (!args.task) throw new Error('Falta --task');
  const sections = skills.map(
    name => `### Skill: ${name}\n${describeSkillDir(name, dir)}\n\n${loadSkill(name, args.maxChars, dir)}`
  );
  return [
    'Sigue ~/.ecc-shared/ECC.md (ECC): plan, TDD, review, seguridad.',
    '',
    `ECC_REQUIRED_SKILLS: ${skills.join(',')}`,
    '',
    '## Skills obligatorias (ya incluidas; no hace falta buscarlas)',
    sections.join('\n\n'),
    '',
    '## Tarea',
    ...(args.notes || []),
    args.task,
    ...(args.context ? ['', '## Contexto de etapas previas', args.context] : []),
    '',
    '## Cierre obligatorio',
    `Antes de terminar, incluye una línea: "ECC-SKILLS-APPLIED: ${skills.join(',')} — <una frase de evidencia por skill>".`
  ].join('\n');
}

function main() {
  try {
    const args = parseArgs(process.argv.slice(2));
    if (args.preset && args.plan) {
      process.stdout.write(`${JSON.stringify(planWithCommands(args), null, 2)}\n`);
      return;
    }
    process.stdout.write(`${buildSpec(args)}\n`);
  } catch (error) {
    process.stderr.write(`ecc-spec: ${error.message}\n`);
    process.exitCode = 1;
  }
}

if (require.main === module) main();

module.exports = {
  buildSpec,
  loadSkill,
  parseArgs,
  stripFrontmatter,
  resolveAutoSkills,
  describeSkillDir,
  resolvePluginRoot,
  applyStage,
  planWithCommands
};
